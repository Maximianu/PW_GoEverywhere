{
  "kind": "collectionType",
  "collectionName": "pedido_missions",
  "info": {
    "singularName": "pedido-mission",
    "pluralName": "pedido-missions",
    "displayName": "Pedido(Mission)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Destino": {
      "type": "enumeration",
      "enum": [
        "Lua",
        "Marte ",
        "Jupiter"
      ]
    },
    "Prioridade": {
      "type": "integer"
    },
    "Estado": {
      "type": "enumeration",
      "enum": [
        "Pendente",
        "Aprovado",
        "Rejeitado",
        "Transito",
        "Concluido"
      ]
    },
    "LocalEntrega": {
      "type": "string"
    },
    "estafeta": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::estafeta.estafeta"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente",
      "inversedBy": "pedido_missions"
    }
  }
}
